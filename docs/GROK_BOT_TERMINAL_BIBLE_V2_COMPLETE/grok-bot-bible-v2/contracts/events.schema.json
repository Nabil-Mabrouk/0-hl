{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "correlation_id",
    "aggregate_id",
    "aggregate_sequence",
    "event_type",
    "occurred_at",
    "source",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregate_id": {
      "type": "string"
    },
    "aggregate_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
