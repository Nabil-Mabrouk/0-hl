{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskPolicy",
  "type": "object",
  "required": [
    "policy_id",
    "version",
    "max_trade_risk_pct",
    "max_token_exposure_pct",
    "max_portfolio_exposure_pct",
    "max_daily_loss_pct",
    "max_slippage_pct"
  ],
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "max_trade_risk_pct": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "max_token_exposure_pct": {
      "type": "string"
    },
    "max_portfolio_exposure_pct": {
      "type": "string"
    },
    "max_daily_loss_pct": {
      "type": "string"
    },
    "max_drawdown_pct": {
      "type": "string"
    },
    "max_slippage_pct": {
      "type": "string"
    },
    "min_liquidity_usd": {
      "type": "string"
    },
    "cooldown_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "kill_switch": {
      "type": "boolean"
    }
  }
}
